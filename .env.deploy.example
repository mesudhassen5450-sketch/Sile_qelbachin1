# Canonical public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://YOUR-WEBSITE-DOMAIN

# Admin public CMS API (website reads published kitabs/media/reminders from Admin)
# Local:  http://127.0.0.1:3001/api/public/v1
# Prod:   https://YOUR-ADMIN-DOMAIN/api/public/v1
NEXT_PUBLIC_CMS_API_BASE=https://YOUR-ADMIN-DOMAIN/api/public/v1

# Public R2 playback (safe in browser)
NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-03bea4f667534df5ab6c67f073c73d1e.r2.dev
NEXT_PUBLIC_R2_OBJECT_PREFIX=sileqelbachin-meadia

