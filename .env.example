# AI assistant (server-side only — never expose this to the browser)
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Canonical site URL used by sitemap.xml / Open Graph / robots.txt
# After custom domain: https://sileqelbachin1.com
NEXT_PUBLIC_SITE_URL=https://sileqelbachin1.netlify.app

# Google Search Console: verify the domain, then submit
#   {NEXT_PUBLIC_SITE_URL}/sitemap.xml
#   {NEXT_PUBLIC_SITE_URL}/robots.txt

# ---------------------------------------------------------------------------
# Cloudflare R2 — public playback (safe for the browser / Next.js client)
# Defaults match production; override only if you change the public bucket URL.
# See CLOUDFLARE_R2.md
# ---------------------------------------------------------------------------
NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-03bea4f667534df5ab6c67f073c73d1e.r2.dev
NEXT_PUBLIC_R2_OBJECT_PREFIX=sileqelbachin-meadia

# ---------------------------------------------------------------------------
# Cloudflare R2 — private credentials (server / CI upload scripts ONLY)
# NEVER put Access Key ID or Secret Access Key in client code or NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_BUCKET_NAME=sileqelbachinmediea
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
