# AI assistant (server-side only — never expose this to the browser)
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Canonical site URL (Open Graph / sitemap / auth redirects)
# Vercel production with custom domain:
NEXT_PUBLIC_SITE_URL=https://sileqelbachin1.com

# Supabase Auth (same project as Admin — publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google OAuth Client Secret stays ONLY in Supabase Dashboard — never here.

# ---------------------------------------------------------------------------
# Admin CMS API (Render) — website proxies via /api/cms
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CMS_API_BASE=https://admin.sileqelbachin1.com/api/public/v1
CMS_REWRITE_TARGET=https://admin.sileqelbachin1.com/api/public/v1
# Local monorepo only:
# NEXT_PUBLIC_CMS_API_BASE=http://127.0.0.1:3000/api/cms
# CMS_REWRITE_TARGET=http://127.0.0.1:3001/api/public/v1

# ---------------------------------------------------------------------------
# Cloudflare R2 — public playback (safe for the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-03bea4f667534df5ab6c67f073c73d1e.r2.dev
NEXT_PUBLIC_R2_OBJECT_PREFIX=sileqelbachin-meadia

# Copy production values into Vercel from .env.vercel.example
