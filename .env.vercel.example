# =============================================================================
# Vercel — PUBLIC WEBSITE env (Project Settings → Environment Variables)
# Apply to: Production (+ Preview if you use preview URLs)
# Admin CMS stays on Render — do NOT point Vercel Root Directory at admincn.
# =============================================================================

# Site URL — custom domain after you attach it in Vercel
NEXT_PUBLIC_SITE_URL=https://sileqelbachin1.com

# Admin published CMS API (server proxy + fallback)
NEXT_PUBLIC_CMS_API_BASE=https://admin.sileqelbachin1.com/api/public/v1
CMS_REWRITE_TARGET=https://admin.sileqelbachin1.com/api/public/v1

# Cloudflare R2 public media
NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-03bea4f667534df5ab6c67f073c73d1e.r2.dev
NEXT_PUBLIC_R2_OBJECT_PREFIX=sileqelbachin-meadia

# Supabase Auth (publishable / anon only — never service role)
NEXT_PUBLIC_SUPABASE_URL=https://lsyyezhsqhzcskjbqmco.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional AI assistant (server-only)
# GROQ_API_KEY=

