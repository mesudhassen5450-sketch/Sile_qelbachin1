# =============================================================================
# ADMIN CMS — deploy env
# Host: Render / Vercel / etc. Copy these into the host dashboard.
# File locally: admincn-1.0.0/.env.local  (do not commit secrets)
# =============================================================================

# Public Admin URL (password-reset redirects, CORS for website)
NEXT_PUBLIC_APP_URL=https://YOUR-ADMIN-DOMAIN

# ---------------------------------------------------------------------------
# Supabase Auth + DB
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Server only — never expose to browser / Flutter / NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Bootstrap Super Admin once after first deploy (run locally or one-off job):
#   SUPER_ADMIN_EMAIL=mesudhassen5450@gmail.com
#   SUPER_ADMIN_BOOTSTRAP_PASSWORD=TEMP_STRONG_PASSWORD
#   npm run auth:bootstrap
SUPER_ADMIN_EMAIL=mesudhassen5450@gmail.com
# SUPER_ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudflare R2 — public (safe for NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
